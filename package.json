{
  "name": "tarkov-workbench",
  "version": "1.9.0-13",
  "private": true,
  "description": "Escape from Tarkov weapon optimizer",
  "author": "CA",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "sync": "node scripts/sync.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:vendor": "node scripts/vendor.mjs",
    "desktop": "electron .",
    "desktop:build": "node scripts/prepare-cp-solver.mjs --check && electron-builder --win --x64 --dir",
    "portable:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "portable:online": "node scripts/build-online.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1 -Online",
    "installer:build": "node scripts/package-installer.cjs",
    "prepare:solvers": "node scripts/prepare-cp-solver.mjs"
  },
  "devDependencies": {
    "highs": "1.15.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ca.tarkov.workbench",
    "productName": "Tarkov Workbench",
    "copyright": "Author: CA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!desktop/native-solver/**/*",
      "!desktop/cp-solver/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "executableName": "Tarkov-Workbench",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "buildVersion": "1.9.0.13",
    "extraResources": [
      {
        "from": "desktop/native-solver",
        "to": "native-solver",
        "filter": [
          "highs.exe",
          "LICENSE.txt",
          "AUTHORS",
          "source.json",
          "THIRD_PARTY_NOTICES.md",
          "licenses/**/*"
        ]
      },
      {
        "from": "desktop/cp-solver",
        "to": "cp-solver",
        "filter": [
          "sat_runner.exe",
          "*.dll",
          "licenses/**/*",
          "source.json"
        ]
      }
    ]
  }
}
